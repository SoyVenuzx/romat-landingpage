---
import { Image } from "astro:assets";
import {
	Activity,
	ArrowRight,
	CalendarCheck2,
	FlaskConical,
	HeartPulse,
	House,
	MapPin,
	Stethoscope,
} from "lucide-react";
import clinicFacadeImage from "../../assets/clinica_desde_afuera.jpg";
import { clinicBusinessData } from "../../utils/seo";

const trustItems = [
	{ icon: Activity, label: "Ultrasonidos diagnósticos" },
	{ icon: FlaskConical, label: "Servicios de laboratorio" },
	{ icon: HeartPulse, label: "Ecocardiograma" },
	{ icon: Stethoscope, label: "Chequeos médicos ocupacionales" },
];

const whatsappMessage = "Hola Servicios Médicos ROMAT, requiero atención médica a mi domicilio. Me gustaría solicitar información.";
const whatsappHref = `https://wa.me/${clinicBusinessData.whatsappNumber.replace(/\D/g, "")}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section id="inicio" class="hero-stage">
  <div class="hero-image-container">
    <Image
      src={clinicFacadeImage}
      alt="Fachada de Servicios Médicos ROMAT en Villa Sol, Managua"
      format="webp"
      class="hero-bg-media"
      width={960}
      height={1080}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      sizes="(max-width: 768px) 100vw, 50vw"
    />
  </div>

  <div class="hero-content-container">
    <!-- Decorative blob behind text for extra contrast/vibe -->
    <div class="pointer-events-none absolute -right-20 -top-20 h-[400px] w-[400px] rounded-full bg-primary/10 blur-[100px]"></div>

    <div class="flex flex-col md:items-start md:text-left">
      <div class="flex w-full max-w-2xl flex-col items-center text-center md:items-start md:text-left">
        
        <span
          class="mb-5 inline-flex animate-fade-up items-center gap-2 rounded-full border border-border/50 bg-white px-4 py-1.5 text-xs font-bold capitalize tracking-wider text-navy shadow-sm"
        >
          <MapPin size={14} className="text-secondary" />
          Villa Sol, Managua
        </span>

        <h1
          class="mb-6 text-4xl font-extrabold leading-[1.05] tracking-tight text-navy motion-safe:opacity-0 motion-safe:animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none [animation-delay:100ms] sm:text-5xl lg:text-6xl"
        >
          Tu salud, en <br class="hidden md:block" /><span class="text-primary">manos expertas</span>
        </h1>

        <p
          class="mb-8 text-base leading-relaxed text-foreground/80 motion-safe:opacity-0 motion-safe:animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none [animation-delay:220ms] sm:text-lg"
        >
          En <b class="text-navy">Servicios Médicos ROMAT</b> cuidamos de ti y tu familia en <b class="text-navy">Managua y Masaya</b>, con especialidades médicas, laboratorio clínico, ultrasonidos y atención personalizada. Tu bienestar, cerca de donde estás.
        </p>

        <div
          class="flex w-full flex-col gap-3 motion-safe:opacity-0 motion-safe:animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none [animation-delay:320ms] sm:flex-row sm:justify-center md:justify-start"
        >
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-white px-5 text-base font-bold text-navy shadow-sm ring-1 ring-border/50 transition-all hover:-translate-y-0.5 hover:bg-slate-50"
          >
            <House size={18} />
            Atención a domicilio
          </a>
          <a
            href="#contacto"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-8 text-base font-bold text-primary-foreground shadow-[0_16px_34px_-14px_hsl(var(--primary)/0.58)] ring-1 ring-white/30 transition-all hover:-translate-y-0.5 hover:bg-primary/90"
          >
            <CalendarCheck2 size={18} />
            Agenda tu cita
          </a>
        </div>

        <div
          class="mt-10 w-full motion-safe:opacity-0 motion-safe:animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none [animation-delay:420ms]"
        >
          <div
            class="flex w-full flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start"
          >
            {
              trustItems.map((item) => (
                <div class="inline-flex items-center justify-start gap-2 rounded-full border border-border/40 bg-white px-3 py-1.5 md:px-4 md:py-2 text-xs md:text-sm font-semibold text-navy shadow-sm sm:w-auto">
                  <div class="flex h-6 w-6 md:h-7 md:w-7 shrink-0 items-center justify-center rounded-full bg-primary/10">
                    <item.icon className="text-primary w-[13px] h-[13px] md:w-[15px] md:h-[15px]" />
                  </div>
                  <span class="text-left">{item.label}</span>
                </div>
              ))
            }
          </div>

          <div class="mt-8 flex justify-center md:justify-start">
            <a
              href="#servicios"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-white/80 backdrop-blur-sm px-6 text-sm font-bold text-navy shadow-sm ring-1 ring-border/50 transition-all hover:-translate-y-0.5 hover:bg-white"
            >
              Conoce nuestros servicios
              <ArrowRight size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
