---
import { Image } from "astro:assets";
import clinicaExterna from "../../assets/clinica_desde_afuera.jpg";
import consultorioImage from "../../assets/consultorio2.jpeg";
import pediatriaImage from "../../assets/pediatria.jpeg";
import laboratorioImage from "../../assets/laboratorio.jpg";
import doctoraImage from "../../assets/doctora.jpg";
import doctorImage from "../../assets/matute.jpeg";
import GalleryCarousel from "../ui/GalleryCarousel";

const gallery = [
  { src: clinicaExterna, alt: "Fachada exterior de Servicios Médicos ROMAT", label: "Nuestra Clínica" },
  { src: consultorioImage, alt: "Consultorios modernos y equipados", label: "Consultorios" },
  { src: pediatriaImage, alt: "Área especializada en Pediatría", label: "Pediatría" },
  { src: laboratorioImage, alt: "Laboratorio de análisis clínicos", label: "Laboratorio Propio" },
  { src: doctoraImage, alt: "Atención médica especializada", label: "Especialistas" },
  { src: doctorImage, alt: "Dr. William Matute, especialista", label: "Atención de Calidad" }
];
---

<section id="nosotros" class="section-vivid section-vivid--soft py-16 lg:py-24 overflow-hidden">
  <div class="container mx-auto px-4 lg:px-8 mb-6 sm:mb-10 text-center" data-reveal>
    <span
      class="mb-4 inline-block rounded-full border border-primary/30 bg-gradient-to-r from-primary/16 via-secondary/14 to-primary/8 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary shadow-[0_12px_28px_-20px_hsl(var(--primary)/0.65)]"
    >
      Sobre nosotros
    </span>
    <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
      Conoce nuestras instalaciones
    </h2>
    <p class="mx-auto max-w-2xl text-lg leading-relaxed text-muted-foreground">
      Diseñadas para tu comodidad y bienestar. Contamos con espacios modernos, limpios y equipados 
      con la mejor tecnología para tu cuidado médico.
    </p>
  </div>

  <div class="relative w-full" data-reveal data-delay="150">
    <GalleryCarousel gallery={gallery} client:visible />
  </div>
</section>
